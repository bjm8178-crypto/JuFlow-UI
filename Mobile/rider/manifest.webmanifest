{
  "name": "JuFlow Rider",
  "short_name": "Rider",
  "description": "Delivery management and navigation for JuFlow",
  "id": "/rider/",
  "start_url": "/rider/?source=pwa",
  "scope": "/rider/",
  "display": "standalone",
  "orientation": "portrait",
  "theme_color": "#39735b",
  "background_color": "#f7f8f4",
  "categories": ["business", "productivity", "navigation"],
  "icons": [
    {
      "src": "/icons/rider-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/rider-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/rider-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Active jobs",
      "short_name": "Jobs",
      "description": "View active deliveries",
      "url": "/rider/#/jobs",
      "icons": [{ "src": "/icons/rider-192.png", "sizes": "192x192" }]
    },
    {
      "name": "Delivery history",
      "short_name": "History",
      "description": "View completed deliveries",
      "url": "/rider/#/history",
      "icons": [{ "src": "/icons/rider-192.png", "sizes": "192x192" }]
    }
  ]
}
