# --- Database (MongoDB Atlas) ---
MONGODB_URI=mongodb://localhost:27017
DB_NAME=juflow
# Atlas example:
# MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority

# --- Server ---
PORT=3000
NODE_ENV=development
TZ=Asia/Manila
# Number of reverse-proxy hops in front of the app (Render = 1, Vercel rewrite + Render = 2)
TRUST_PROXY=1
# Comma-separated browser origins allowed to call the API (your Vercel URL). Required for CSRF origin check in production.
CORS_ORIGINS=http://localhost:8080

# --- First admin (created on boot only if no admin exists; remove ADMIN_PASSWORD afterwards) ---
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
ADMIN_EMAIL=

# --- Single rider (created on boot when RIDER_PASSWORD is at least 8 characters) ---
# RIDER_USERNAME=
# RIDER_PASSWORD=

# --- Cashier device (POST /api/cashier/sales). Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CASHIER_API_TOKEN=

# --- Seeding (DESTRUCTIVE, dev only) ---
# ADMIN_INITIAL_PASSWORD=
# ALLOW_SEED_IN_PRODUCTION=false
