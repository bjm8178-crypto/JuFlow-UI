{
  "name": "Juki Cashier",
  "short_name": "Cashier",
  "description": "Point of sale and order management for Juki",
  "id": "/cashier/",
  "start_url": "/cashier/?source=pwa",
  "scope": "/cashier/",
  "display": "standalone",
  "orientation": "portrait",
  "theme_color": "#bc5125",
  "background_color": "#f7f8f4",
  "categories": ["business", "productivity"],
  "icons": [
    {
      "src": "/icons/cashier-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/cashier-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/cashier-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Sell dishes",
      "short_name": "Sell",
      "description": "Open point of sale",
      "url": "/cashier/#/sell",
      "icons": [{ "src": "/icons/cashier-192.png", "sizes": "192x192" }]
    },
    {
      "name": "Order queue",
      "short_name": "Orders",
      "description": "View active orders",
      "url": "/cashier/#/orders",
      "icons": [{ "src": "/icons/cashier-192.png", "sizes": "192x192" }]
    },
    {
      "name": "New order",
      "short_name": "New",
      "description": "Create delivery order",
      "url": "/cashier/#/new-order",
      "icons": [{ "src": "/icons/cashier-192.png", "sizes": "192x192" }]
    }
  ]
}
